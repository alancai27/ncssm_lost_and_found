# ---- Google sign-in ----
# Only @ncssm.edu Google accounts can post items or mark them returned.
#
# Google Cloud Console -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#
# Authorized redirect URI must match the running server EXACTLY:
#   http://localhost:5000/auth/callback     (local)
#   https://your-domain/auth/callback       (deployed)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ALLOWED_EMAIL_DOMAIN=ncssm.edu

# Set only if the callback URL Flask builds is wrong (behind a proxy, etc).
# OAUTH_REDIRECT_URI=https://your-domain/auth/callback

# Also require sign-in to browse and search, not just to post.
# REQUIRE_LOGIN_TO_VIEW=1

# ---- AI ----
# Free key from https://aistudio.google.com/apikey
# Without it the app still runs -- search falls back to keyword matching
# and uploads are not auto-described.
GEMINI_API_KEY=

# Override if check_ai.py says this model is unavailable to your key.
GEMINI_MODEL=gemini-3.6-flash

# ---- Production storage ----
# Unset locally: the app uses SQLite and static/uploads/, and neither psycopg
# nor boto3 is imported. Both are required in production, because Render's
# free tier wipes its filesystem on every deploy.
#
# Verify these before deploying:  python3 scripts/check_deploy.py

# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname

# Supabase Storage -> S3 Configuration -> Access keys.
# S3_REGION must be the real region shown there; 'auto' works for Cloudflare
# R2 but makes Supabase reject every request with SignatureDoesNotMatch.
# S3_BUCKET=lost-and-found
# S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# ---- Server ----
# Required in production: signed session cookies are what keep people logged
# in, so this must be a fixed random string, not regenerated on each boot.
SECRET_KEY=

# Set to 1 when serving over HTTPS so session cookies are marked Secure.
HTTPS_ONLY=0

PORT=5000
